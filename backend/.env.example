# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_LOCAL_MODEL=llama3.1

# Database
DATABASE_URL=sqlite:///./ai_assistant.db

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Tool OAuth (will configure later)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
